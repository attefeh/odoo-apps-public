<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_multiple_print_wizard_form" model="ir.ui.view">
        <field name="name">account.move.multiple.print.wizard.form</field>
        <field name="model">account.move.multiple.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Multiple Copies">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="copies"/>
                </group>
                <footer>
                    <button name="action_print"
                            type="object"
                            string="Print"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_move_multiple_print_wizard" model="ir.actions.act_window">
        <field name="name">Print Multiple Copies</field>
        <field name="res_model">account.move.multiple.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
