<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_form_inherit_rate_guard" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.rate.guard</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="rate_guard_required"/>
            </xpath>
        </field>
    </record>

    <record id="view_currency_tree_inherit_rate_guard" model="ir.ui.view">
        <field name="name">res.currency.list.inherit.rate.guard</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="rate_guard_required" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
