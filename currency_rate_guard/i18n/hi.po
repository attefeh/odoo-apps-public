#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "%(date)s को %(currency)s के लिए कोई विनिमय दर पंजीकृत नहीं की गई है। कृपया जारी रखने से पहले आज की दर दर्ज करें।"
