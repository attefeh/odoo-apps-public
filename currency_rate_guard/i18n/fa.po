#. module: currency_rate_guard
#: model:ir.module.module,shortdesc:base.module_currency_rate_guard
msgid "Currency Rate Guard"
msgstr "نگهبان نرخ ارز"

#. module: currency_rate_guard
#: model:ir.module.module,summary:base.module_currency_rate_guard
msgid ""
"Block confirmation/posting of purchase orders, vendor bills, customer "
"invoices and payments when today's currency rate is missing for guarded "
"currencies. Daily reminder to accountants."
msgstr ""
"اگر نرخ ارز امروز برای ارزهای پاسبانی‌شده ثبت نشده باشد، تأیید/ثبت سفارش‌های "
"خرید، قبض‌های فروشنده، فاکتورهای مشتری و پرداخت‌ها را مسدود می‌کند. یادآور "
"روزانه برای حسابداران."

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_res_currency__rate_guard_required
msgid "Require Daily Rate"
msgstr "نیاز به نرخ روزانه"

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_res_currency__rate_guard_required
msgid ""
"If set, posting/confirming any document in this currency is blocked unless "
"a currency rate exists for today."
msgstr ""
"اگر فعال باشد، ثبت/تأیید هر سندی در این ارز تا زمانی که نرخ ارز برای امروز "
"ثبت نشده باشد، مسدود می‌شود."

#. module: currency_rate_guard
#: model:ir.model,name:currency_rate_guard.model_currency_rate_quick_entry_wizard
msgid "Quick Entry for Today's Currency Rate"
msgstr "ورود سریع نرخ ارز امروز"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__currency_id
msgid "Currency"
msgstr "ارز"

#. module: currency_rate_guard
