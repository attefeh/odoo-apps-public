msgid "Rate must be strictly positive."
msgstr "రేటు ఖచ్చితంగా ధనాత్మకంగా ఉండాలి."

#. module: currency_rate_guard
#: code:addons/currency_rate_guard/models/res_currency.py:0
#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "%(date)s నాడు %(currency)s కోసం ఎటువంటి మారకపు రేటు నమోదు చేయబడలేదు. కొనసాగించే ముందు నేటి రేటును నమోదు చేయండి."
