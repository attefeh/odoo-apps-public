#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "No se ha registrado ningún tipo de cambio para %(currency)s en %(date)s. Introduzca el tipo de cambio de hoy antes de continuar."
