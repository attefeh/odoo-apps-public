#. module: currency_rate_guard
#: model_terms:ir.ui.view,arch_db:currency_rate_guard.view_currency_rate_quick_entry_wizard_form
msgid "Cancel"
msgstr "Prekliči"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_id
msgid "Company"
msgstr "Podjetje"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_currency_id
msgid "Company Currency"
msgstr "Valuta podjetja"

#. module: currency_rate_guard
#: model:ir.module.module,summary:base.module_currency_rate_guard
msgid "Block confirmation/posting of purchase orders, vendor bills, customer invoices and payments when today's currency rate is missing for guarded currencies."
msgstr "Blokira potrditev/knjiženje nabavnih naročil, dobaviteljskih računov, izdanih računov in plačil, ko za varovane valute manjka današnji menjalni tečaj."

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_account_move__used_company_rate
msgid "Company-currency exchange rate applied for this document's invoice date."
msgstr "Menjalni tečaj valute podjetja, uporabljen za datum računa tega dokumenta."

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_purchase_order__used_company_rate
msgid "Company-currency exchange rate applied for this order's approval date."
msgstr "Menjalni tečaj valute podjetja, uporabljen za datum odobritve tega naročila."

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_account_payment__used_company_rate
msgid "Company-currency exchange rate applied for this payment's date."
msgstr "Menjalni tečaj valute podjetja, uporabljen za datum tega plačila."

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__currency_id
msgid "Currency"
msgstr "Valuta"

#. module: currency_rate_guard
#: model:ir.module.module,shortdesc:base.module_currency_rate_guard
msgid "Currency Rate Guard"
msgstr "Varuh menjalnega tečaja"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__date
msgid "Date"
msgstr "Datum"

#. module: currency_rate_guard
#: code:addons/currency_rate_guard/models/res_currency.py:0
#, python-format
msgid "Enter Rate for %(date)s"
msgstr "Vnesite tečaj za %(date)s"

#. module: currency_rate_guard
#: model:ir.actions.act_window,name:currency_rate_guard.action_currency_rate_quick_entry_wizard
#: model_terms:ir.ui.view,arch_db:currency_rate_guard.view_currency_rate_quick_entry_wizard_form
msgid "Enter Today's Rate"
msgstr "Vnesite današnji tečaj"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_account_move__used_company_rate
#: model:ir.model.fields,field_description:currency_rate_guard.field_account_payment__used_company_rate
#: model:ir.model.fields,field_description:currency_rate_guard.field_purchase_order__used_company_rate
msgid "Exchange Rate Used"
msgstr "Uporabljeni menjalni tečaj"

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_rate
msgid "How many units of the selected currency equal 1 unit of the company currency (e.g. 1 OMR = X IRR)."
msgstr "Koliko enot izbrane valute je enakovrednih 1 enoti valute podjetja (npr. 1 OMR = X IRR)."

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_res_currency__rate_guard_required
msgid "If set, posting/confirming any document in this currency is blocked unless a currency rate exists for today."
msgstr "Če je nastavljeno, je knjiženje/potrjevanje katerega koli dokumenta v tej valuti blokirano, dokler ne obstaja menjalni tečaj za danes."

#. module: currency_rate_guard
#: code:addons/currency_rate_guard/models/res_currency.py:0
#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter the rate for that date before continuing."
msgstr "Za %(currency)s na dan %(date)s ni registriranega menjalnega tečaja. Pred nadaljevanjem vnesite tečaj za ta datum."

#. module: currency_rate_guard
#: model:ir.model,name:currency_rate_guard.model_currency_rate_quick_entry_wizard
msgid "Quick Entry for Today's Currency Rate"
msgstr "Hiter vnos današnjega menjalnega tečaja"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_rate
msgid "Rate"
msgstr "Tečaj"

#. module: currency_rate_guard
#: code:addons/currency_rate_guard/wizard/currency_rate_quick_entry.py:0
#, python-format
msgid "Rate must be strictly positive."
msgstr "Tečaj mora biti strogo pozitiven."

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_res_currency__rate_guard_required
msgid "Require Daily Rate"
msgstr "Zahtevaj dnevni tečaj"

#. module: currency_rate_guard
#: model_terms:ir.ui.view,arch_db:currency_rate_guard.view_currency_rate_quick_entry_wizard_form
msgid "Save Rate"
msgstr "Shrani tečaj"

#. module: currency_rate_guard
#: code:addons/currency_rate_guard/models/res_currency.py:0
#, python-format
msgid "The rate for %(currency)s on %(date)s is already used by %(doc)s and can no longer be changed or removed. Delete that document first if you need to modify this rate."
msgstr "Tečaj za %(currency)s na dan %(date)s že uporablja %(doc)s in ga ni več mogoče spremeniti ali odstraniti. Če morate ta tečaj spremeniti, najprej izbrišite ta dokument."

