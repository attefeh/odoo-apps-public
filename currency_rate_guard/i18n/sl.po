#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "Za %(currency)s na dan %(date)s ni registriranega menjalnega tečaja. Pred nadaljevanjem vnesite današnji tečaj."
