#. module: currency_rate_guard
#: code:addons/currency_rate_guard/models/res_currency.py:0
#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "%(date)s-ზე %(currency)s-სთვის გაცვლის კურსი არ არის რეგისტრირებული. გთხოვთ, გაგრძელებამდე შეიყვანოთ დღევანდელი კურსი."
