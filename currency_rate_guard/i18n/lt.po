#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "%(date)s valiutai %(currency)s nebuvo užregistruotas joks valiutos kursas. Prieš tęsdami įveskite šiandienos kursą."
