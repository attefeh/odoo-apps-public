#, python-format
msgid "No exchange rate has been registered for %(currency)s on %(date)s. Please enter today's rate before continuing."
msgstr "Non se rexistrou ningún tipo de cambio para %(currency)s o %(date)s. Introduza o tipo de cambio de hoxe antes de continuar."
