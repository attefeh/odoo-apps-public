#. module: currency_rate_guard
#: model:ir.module.module,shortdesc:base.module_currency_rate_guard
msgid "Currency Rate Guard"
msgstr "Árfolyam-őr"

#. module: currency_rate_guard
#: model:ir.module.module,summary:base.module_currency_rate_guard
msgid "Block confirmation/posting of purchase orders, vendor bills, customer invoices and payments when today's currency rate is missing for guarded currencies. Daily reminder to accountants."
msgstr "Beszerzési megrendelések, szállítói számlák, vevői számlák és fizetések jóváhagyásának/könyvelésének blokkolása, ha a mai árfolyam hiányzik a felügyelt pénznemeknél. Napi emlékeztető a könyvelőknek."

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_res_currency__rate_guard_required
msgid "Require Daily Rate"
msgstr "Napi árfolyam megkövetelése"

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_res_currency__rate_guard_required
msgid "If set, posting/confirming any document in this currency is blocked unless a currency rate exists for today."
msgstr "Ha be van állítva, az ebben a pénznemben lévő dokumentumok könyvelése/jóváhagyása blokkolva van, hacsak nem létezik mai árfolyam."

#. module: currency_rate_guard
#: model:ir.model,name:currency_rate_guard.model_currency_rate_quick_entry_wizard
msgid "Quick Entry for Today's Currency Rate"
msgstr "Mai árfolyam gyors rögzítése"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__currency_id
msgid "Currency"
msgstr "Pénznem"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_id
msgid "Company"
msgstr "Vállalat"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__company_currency_id
msgid "Company Currency"
msgstr "Vállalati pénznem"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__date
msgid "Date"
msgstr "Dátum"

#. module: currency_rate_guard
#: model:ir.model.fields,field_description:currency_rate_guard.field_currency_rate_quick_entry_wizard__inverse_company_rate
msgid "Rate"
msgstr "Árfolyam"

#. module: currency_rate_guard
#: model:ir.model.fields,help:currency_rate_guard.field_currency_rate_quick_entry_wizard__inverse_company_rate
msgid "How many units of the company currency equal 1 unit of the selected currency (e.g. 1 OMR = X IRR)."
msgstr "Hány egységnyi vállalati pénznem egyenlő a kiválasztott pénznem 1 egységével (pl. 1 OMR = X IRR)."

#. module: currency_rate_guard
#: model:ir.actions.act_window,name:currency_rate_guard.action_currency_rate_quick_entry_wizard
#: model_terms:ir.ui.view,arch_db:currency_rate_guard.view_currency_rate_quick_entry_wizard_form
#: code:addons/currency_rate_guard/models/res_currency.py:0
