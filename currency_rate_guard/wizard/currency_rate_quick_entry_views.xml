<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_rate_quick_entry_wizard_form" model="ir.ui.view">
        <field name="name">currency.rate.quick.entry.wizard.form</field>
        <field name="model">currency.rate.quick.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Today's Rate">
                <group>
                    <field name="resume_model" invisible="1"/>
                    <field name="resume_res_id" invisible="1"/>
                    <field name="resume_method" invisible="1"/>
                    <field name="currency_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="company_currency_id"/>
                    <field name="date"/>
                    <field name="company_rate"/>
                </group>
                <footer>
                    <button name="action_save"
                            type="object"
                            string="Save Rate"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_currency_rate_quick_entry_wizard" model="ir.actions.act_window">
        <field name="name">Enter Today's Rate</field>
        <field name="res_model">currency.rate.quick.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
