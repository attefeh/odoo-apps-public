#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Isang umiiral na Naka-iskedyul na Aksyon na tatakbo sa mga oras na nasa ibaba. Habang aktibo ang handler na ito, ide-deactivate ang naka-link na aksyon, kaya hihinto itong tumakbo sa sarili nitong interval at tatakbo lamang ayon sa iskedyul na ito."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Nakarehistrong modelo ng Odoo na nagtatakda ng method na patatakbuhin. Nakatago ang mga transient (wizard) na modelo. Hindi kailangan kapag may naka-link na Naka-iskedyul na Aksyon."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Pangalan ng isang method sa target na modelo. Tinatawag sa recordset ng modelo nang walang argumento (gamitin ang env context o mga search handler kung kinakailangan). Hindi kailangan kapag may naka-link na Naka-iskedyul na Aksyon."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Lokal na timezone na ginagamit upang itugma ang mga oras ng iskedyul."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Lokal na oras (0–23). Tumatakbo ang dispatcher isang beses bawat oras at itinutugma lamang ang oras na ito."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Ginagamit lamang kapag ang dalas ay Lingguhan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Ginagamit lamang kapag ang dalas ay Buwanan. Kung mas maikli ang buwan, ang huling araw ang ginagamit."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Awtomatikong itinatakda kapag dini-deactivate ng isang Cron Handler ang naka-iskedyul na aksyon na ito upang kunin ang timing nito. Muling ia-activate ang naka-iskedyul na aksyon kapag wala nang aktibong handler na namamahala dito."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Hindi kilalang modelo: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Ang modelong “%s” ay abstract at hindi maaaring gamitin bilang target ng cron."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Magtakda ng naka-link na Naka-iskedyul na Aksyon, o kapwa ng Target na Modelo at Pangalan ng method."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Hindi wastong timezone “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Walang naka-configure na target para sa handler na “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Nawawala ang method na “%s” o hindi ito matatawag sa modelong “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Ang araw ng buwan ay dapat nasa pagitan ng 1 at 31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Mangyaring magtakda ng araw ng linggo para sa mga lingguhang iskedyul."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Ang oras ng araw ay dapat nasa pagitan ng 0 at 23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Ang naka-link na Naka-iskedyul na Aksyon ay dini-deactivate habang aktibo ang handler na ito, kaya hihinto itong tumakbo sa sarili nitong interval at tatakbo lamang sa mga oras na nakatakda sa ibaba. Muli itong ia-activate kung aalisin mo ang link o ide-deactivate mo ang handler na ito."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Patakbuhin ang mga naka-iskedyul na aksyon sa nakatakdang oras ng araw (3 PM araw-araw, atbp.) sa halip na nakapirming interval"
