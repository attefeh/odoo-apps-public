msgid "Unknown model: %s"
msgstr "Nezināms modelis: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Modelis „%s“ ir abstrakts, un to nevar izmantot kā cron mērķi."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Iestatiet saistītu Scheduled Action vai gan Mērķa modeli, gan Metodes nosaukumu."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Nederīga laika josla „%s“."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Apstrādātājam „%s“ nav konfigurēts mērķis."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Metode „%s“ trūkst vai nav izsaucama modelī „%s“."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Mēneša dienai jābūt no 1 līdz 31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Lūdzu, iestatiet nedēļas dienu iknedēļas grafikiem."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Dienas stundai jābūt no 0 līdz 23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Saistītā Scheduled Action tiek deaktivizēta, kamēr šis apstrādātājs ir aktīvs, tāpēc tā pārstāj darboties savā intervālā un tiek izpildīta tikai zemāk noteiktajos laikos. Tā tiek atkārtoti aktivizēta, ja noņemat saiti vai deaktivizējat šo apstrādātāju."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Izpildiet ieplānotās darbības noteiktā dienas laikā (piem., katru dienu plkst. 15:00), nevis fiksētos intervālos"
