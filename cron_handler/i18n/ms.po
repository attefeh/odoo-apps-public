#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Scheduled Action sedia ada untuk dijalankan pada masa di bawah. Semasa pengendali ini aktif, tindakan yang dipautkan dinyahaktifkan, jadi ia berhenti berjalan pada selang waktunya sendiri dan hanya berjalan mengikut jadual ini."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Model Odoo berdaftar yang menentukan kaedah untuk dijalankan. Model transien (bestari) disembunyikan. Tidak diperlukan apabila Scheduled Action dipautkan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Nama kaedah pada model sasaran. Dipanggil pada set rekod model tanpa argumen (gunakan konteks env atau pengendali carian jika perlu). Tidak diperlukan apabila Scheduled Action dipautkan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Zon waktu tempatan yang digunakan untuk memadankan masa jadual."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Jam tempatan (0–23). Penghantar berjalan sekali setiap jam dan memadankan jam ini sahaja."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Hanya digunakan apabila kekerapan ialah Mingguan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Hanya digunakan apabila kekerapan ialah Bulanan. Jika bulan lebih pendek, hari terakhir digunakan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Ditetapkan secara automatik apabila Pengendali Cron menyahaktifkan tindakan berjadual ini untuk mengambil alih pemasaannya. Tindakan berjadual diaktifkan semula sebaik sahaja tiada pengendali aktif menguruskannya lagi."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Model tidak diketahui: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Model “%s” adalah abstrak dan tidak boleh digunakan sebagai sasaran cron."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Tetapkan Scheduled Action yang dipautkan, atau kedua-dua Model Sasaran dan Nama kaedah."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Zon waktu tidak sah “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Tiada sasaran dikonfigurasikan untuk pengendali “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Kaedah “%s” tiada atau tidak boleh dipanggil pada model “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Hari dalam bulan mestilah antara 1 dan 31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Sila tetapkan hari dalam minggu untuk jadual mingguan."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Jam dalam sehari mestilah antara 0 dan 23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Scheduled Action yang dipautkan dinyahaktifkan semasa pengendali ini aktif, jadi ia berhenti berjalan pada selang waktunya sendiri dan hanya berjalan pada masa yang ditakrifkan di bawah. Ia diaktifkan semula jika anda mengosongkan pautan atau menyahaktifkan pengendali ini."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Jalankan scheduled actions pada masa tertentu dalam sehari (cth. 3 PM setiap hari) dan bukannya selang tetap"
