#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Beheko orduetan exekutatzeko dagoen programatutako ekintza bat. Kudeatzaile hau aktibo dagoen bitartean, lotutako ekintza desaktibatzen da, beraz, bere tartean exekutatzeari uzten dio eta ordutegi honetan soilik exekutatzen da."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Exekutatu beharreko metodoa definitzen duen Odoo eredu erregistratua. Behin-behineko (laguntzaile) ereduak ezkutatuta daude. Ez da beharrezkoa programatutako ekintza bat lotuta dagoenean."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Helburu-ereduko metodo baten izena. Ereduaren erregistro-multzoan deitzen da argumenturik gabe (erabili env testuingurua edo bilaketa-kudeatzaileak beharrezkoa bada). Ez da beharrezkoa programatutako ekintza bat lotuta dagoenean."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Ordutegiko orduak parekatzeko erabiltzen den tokiko ordu-eremua."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Tokiko ordua (0–23). Banatzailea orduro behin exekutatzen da eta ordu hau soilik parekatzen du."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Maiztasuna Astero denean soilik erabiltzen da."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Maiztasuna Hilero denean soilik erabiltzen da. Hilabetea laburragoa bada, azken eguna erabiltzen da."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Automatikoki ezartzen da Cron kudeatzaile batek programatutako ekintza hau desaktibatzen duenean bere denbora bereganatzeko. Programatutako ekintza berriz aktibatzen da kudeatzaile aktiborik ez duenean kudeatzen."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Eredu ezezaguna: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "„%s“ eredua abstraktua da eta ezin da cron helburu gisa erabili."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Ezarri lotutako programatutako ekintza bat, edo helburu-eredua eta metodoaren izena."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Baliogabeko ordu-eremua „%s“."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Ez da helbururik konfiguratu „%s“ kudeatzailearentzat."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "„%s“ metodoa falta da edo ezin da deitu „%s“ ereduan."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Hileko egunak 1 eta 31 artekoa izan behar du."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Mesedez, ezarri asteguna asteroko ordutegietarako."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Eguneko orduak 0 eta 23 artekoa izan behar du."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Lotutako programatutako ekintza desaktibatzen da kudeatzaile hau aktibo dagoen bitartean, beraz, bere tartean exekutatzeari uzten dio eta behean definitutako orduetan soilik exekutatzen da. Berriz aktibatzen da lotura kentzen baduzu edo kudeatzaile hau desaktibatzen baduzu."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Exekutatu programatutako ekintzak eguneko ordu jakin batean (15:00etan egunero, etab.) tarte finkoen ordez"
