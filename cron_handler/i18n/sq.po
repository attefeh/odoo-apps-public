#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Një Veprim i planifikuar ekzistues që do të ekzekutohet në oraret e mëposhtme. Ndërsa ky menaxhues është aktiv, veprimi i lidhur çaktivizohet, kështu që ndalon së ekzekutuari në intervalin e vet dhe ekzekutohet vetëm sipas këtij orari."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Model Odoo i regjistruar që përcakton metodën për t'u ekzekutuar. Modelet kalimtare (asistentët) janë të fshehura. Nuk nevojitet kur është lidhur një Veprim i planifikuar."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Emri i një metode në modelin e synuar. Thirret në grupin e regjistrimeve të modelit pa argumente (përdorni kontekstin env ose metodat e kërkimit nëse nevojitet). Nuk nevojitet kur është lidhur një Veprim i planifikuar."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Zona kohore lokale e përdorur për të përputhur oraret e planifikuara."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Ora lokale (0–23). Shpërndarësi ekzekutohet një herë në orë dhe përputhet vetëm me këtë orë."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Përdoret vetëm kur frekuenca është Javore."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Përdoret vetëm kur frekuenca është Mujore. Nëse muaji është më i shkurtër, përdoret dita e fundit."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Vendoset automatikisht kur një Menaxhues i Cron çaktivizon këtë veprim të planifikuar për të marrë përsipër kohëzimin e tij. Veprimi i planifikuar riaktivizohet sapo asnjë menaxhues aktiv nuk e menaxhon më atë."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Model i panjohur: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Modeli „%s” është abstrakt dhe nuk mund të përdoret si objektiv cron."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Vendosni një Veprim të planifikuar të lidhur, ose si Modelin e synuar ashtu edhe Emrin e metodës."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Zonë kohore e pavlefshme „%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Asnjë objektiv i konfiguruar për menaxhuesin „%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Metoda „%s” mungon ose nuk mund të thirret në modelin „%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Dita e muajit duhet të jetë midis 1 dhe 31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Ju lutemi vendosni një ditë jave për oraret javore."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Ora e ditës duhet të jetë midis 0 dhe 23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Veprimi i planifikuar i lidhur çaktivizohet ndërsa ky menaxhues është aktiv, kështu që ndalon së ekzekutuari në intervalin e vet dhe ekzekutohet vetëm në oraret e përcaktuara më poshtë. Ai riaktivizohet nëse hiqni lidhjen ose çaktivizoni këtë menaxhues."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Ekzekutoni veprime të planifikuara në një orë të caktuar të ditës (15:00 çdo ditë, etj.) në vend të intervaleve fikse"
