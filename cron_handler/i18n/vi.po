#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Một Scheduled Action hiện có để chạy vào các thời điểm bên dưới. Khi trình xử lý này đang hoạt động, hành động được liên kết sẽ bị vô hiệu hóa, vì vậy nó ngừng chạy theo khoảng thời gian riêng và chỉ chạy theo lịch trình này."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Mô hình Odoo đã đăng ký xác định phương thức cần chạy. Các mô hình tạm thời (wizard) bị ẩn. Không cần thiết khi đã liên kết một Scheduled Action."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Tên của một phương thức trên mô hình mục tiêu. Được gọi trên tập bản ghi của mô hình mà không có đối số (sử dụng ngữ cảnh env hoặc trình xử lý tìm kiếm nếu cần). Không cần thiết khi đã liên kết một Scheduled Action."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Múi giờ địa phương được dùng để khớp thời gian lịch trình."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Giờ địa phương (0–23). Bộ điều phối chạy một lần mỗi giờ và chỉ khớp với giờ này."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Chỉ được sử dụng khi tần suất là Hàng tuần."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Chỉ được sử dụng khi tần suất là Hàng tháng. Nếu tháng ngắn hơn, ngày cuối cùng sẽ được sử dụng."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Được đặt tự động khi một Trình xử lý Cron vô hiệu hóa hành động đã lên lịch này để tiếp quản thời gian của nó. Hành động đã lên lịch được kích hoạt lại khi không còn trình xử lý hoạt động nào quản lý nó nữa."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Mô hình không xác định: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Mô hình “%s” là trừu tượng và không thể được dùng làm mục tiêu cron."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Đặt một Scheduled Action được liên kết, hoặc cả Mô hình mục tiêu và Tên phương thức."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Múi giờ không hợp lệ “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Không có mục tiêu nào được cấu hình cho trình xử lý “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Phương thức “%s” bị thiếu hoặc không thể gọi được trên mô hình “%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Ngày trong tháng phải nằm trong khoảng từ 1 đến 31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Vui lòng đặt một ngày trong tuần cho lịch trình hàng tuần."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Giờ trong ngày phải nằm trong khoảng từ 0 đến 23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Scheduled Action được liên kết sẽ bị vô hiệu hóa khi trình xử lý này đang hoạt động, vì vậy nó ngừng chạy theo khoảng thời gian riêng và chỉ chạy vào các thời điểm được xác định bên dưới. Nó được kích hoạt lại nếu bạn xóa liên kết hoặc vô hiệu hóa trình xử lý này."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Chạy scheduled actions vào một thời điểm cố định trong ngày (3 giờ chiều hàng ngày, v.v.) thay vì các khoảng thời gian cố định"
