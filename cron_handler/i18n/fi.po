#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__cron_id
msgid "An existing Scheduled Action to run at the times below. While this handler is active the linked action is deactivated, so it stops running on its own interval and only runs on this schedule."
msgstr "Olemassa oleva ajastettu toiminto, joka suoritetaan alla määritettyinä aikoina. Kun tämä käsittelijä on aktiivinen, linkitetty toiminto poistetaan käytöstä, joten se ei enää suoriudu omalla aikavälillään vaan ainoastaan tämän aikataulun mukaan."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__model_id
msgid "Registered Odoo model that defines the method to run. Transient (wizard) models are hidden. Not needed when a Scheduled Action is linked."
msgstr "Rekisteröity Odoo-malli, joka määrittää suoritettavan metodin. Tilapäiset (ohjattujen toimintojen) mallit on piilotettu. Ei tarvita, kun ajastettu toiminto on linkitetty."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__run_method
msgid "Name of a method on the target model. Called on the model recordset with no arguments (use env context or search handlers if needed). Not needed when a Scheduled Action is linked."
msgstr "Kohdemallin metodin nimi. Kutsutaan mallin tietuejoukolle ilman argumentteja (käytä tarvittaessa env-kontekstia tai hakukäsittelijöitä). Ei tarvita, kun ajastettu toiminto on linkitetty."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler__timezone
msgid "Local timezone used to match schedule times."
msgstr "Paikallinen aikavyöhyke, jota käytetään aikataulun aikojen täsmäyttämiseen."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__hour
msgid "Local hour (0–23). The dispatcher runs once per hour and matches this hour only."
msgstr "Paikallinen tunti (0–23). Lähetin suoritetaan kerran tunnissa ja täsmää vain tähän tuntiin."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__weekday
msgid "Only used when frequency is Weekly."
msgstr "Käytetään vain, kun toistuvuus on Viikoittain."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_cron_handler_schedule_line__month_day
msgid "1–31. Only used when frequency is Monthly. If the month is shorter, the last day is used."
msgstr "1–31. Käytetään vain, kun toistuvuus on Kuukausittain. Jos kuukausi on lyhyempi, käytetään sen viimeistä päivää."

#. module: cron_handler
#: model:ir.model.fields,help:cron_handler.field_ir_cron__handler_managed
msgid "Set automatically when a Cron Handler deactivates this scheduled action to take over its timing. The scheduled action is re-activated once no active handler manages it anymore."
msgstr "Asetetaan automaattisesti, kun Cron-käsittelijä poistaa tämän ajastetun toiminnon käytöstä ottaakseen sen ajastuksen haltuunsa. Ajastettu toiminto aktivoidaan uudelleen heti, kun mikään aktiivinen käsittelijä ei enää hallinnoi sitä."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Unknown model: %s"
msgstr "Tuntematon malli: %s"

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Model “%s” is abstract and cannot be used as a cron target."
msgstr "Malli ”%s” on abstrakti, eikä sitä voi käyttää cron-kohteena."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Set a linked Scheduled Action, or both a Target Model and a Method name."
msgstr "Aseta linkitetty ajastettu toiminto tai sekä kohdemalli että metodin nimi."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Invalid timezone “%s”."
msgstr "Virheellinen aikavyöhyke ”%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "No target configured for handler “%s”."
msgstr "Käsittelijälle ”%s” ei ole määritetty kohdetta."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
#, python-format
msgid "Method “%s” is missing or not callable on model “%s”."
msgstr "Metodi ”%s” puuttuu tai sitä ei voi kutsua mallissa ”%s”."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Day of month must be between 1 and 31."
msgstr "Kuukauden päivän on oltava välillä 1–31."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Please set a weekday for weekly schedules."
msgstr "Aseta viikonpäivä viikoittaisille aikatauluille."

#. module: cron_handler
#: code:addons/cron_handler/models/cron_handler.py:0
msgid "Hour of day must be between 0 and 23."
msgstr "Vuorokaudenajan (tunnin) on oltava välillä 0–23."

#. module: cron_handler
#: model_terms:ir.ui.view,arch_db:cron_handler.view_cron_handler_form
msgid "The linked Scheduled Action is deactivated while this handler is active, so it stops running on its own interval and runs only at the times defined below. It is re-activated if you clear the link or deactivate this handler."
msgstr "Linkitetty ajastettu toiminto poistetaan käytöstä, kun tämä käsittelijä on aktiivinen, joten se ei enää suoriudu omalla aikavälillään vaan ainoastaan alla määritettyinä aikoina. Se aktivoidaan uudelleen, jos poistat linkin tai poistat tämän käsittelijän käytöstä."

#. module: cron_handler
#: model:ir.module.module,summary:base.module_cron_handler
msgid "Run scheduled actions at a set time of day (3 PM daily, etc.) instead of fixed intervals"
msgstr "Suorita ajastettuja toimintoja tiettyyn vuorokaudenaikaan (esim. klo 15 päivittäin) kiinteiden aikavälien sijaan"
