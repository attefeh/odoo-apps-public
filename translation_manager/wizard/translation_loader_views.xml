<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_translation_loader_form" model="ir.ui.view">
        <field name="name">translation.loader.form</field>
        <field name="model">translation.loader</field>
        <field name="arch" type="xml">
            <form string="Load Translated Terms">
                <sheet>
                    <div class="oe_title">
                        <h1>Load / Refresh Terms</h1>
                    </div>
                    <group>
                        <group>
                            <field name="scope" widget="radio"/>
                            <field name="load_db"/>
                            <field name="load_code"/>
                        </group>
                        <group>
                            <field name="record_limit"/>
                            <field name="purge_first"/>
                        </group>
                    </group>
                    <group string="Languages">
                        <field name="lang_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Filters" invisible="scope != 'filter'">
                        <field name="model_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               invisible="not load_db"/>
                        <field name="module_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               invisible="not load_code"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="scope != 'all'">
                        Loading every term of every installed module for all
                        selected languages can be heavy on a large database.
                        Use the <b>Selected models / modules</b> scope for
                        day-to-day work.
                    </div>
                </sheet>
                <footer>
                    <button name="action_load" type="object" string="Load"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_translation_loader" model="ir.actions.act_window">
        <field name="name">Load / Refresh Terms</field>
        <field name="res_model">translation.loader</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
