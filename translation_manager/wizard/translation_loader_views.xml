<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_translation_loader_form" model="ir.ui.view">
        <field name="name">translation.loader.form</field>
        <field name="model">translation.loader</field>
        <field name="arch" type="xml">
            <form string="Refresh Translated Terms">
                <sheet>
                    <div class="oe_title">
                        <h1>Refresh Translated Terms</h1>
                    </div>
                    <p>
                        Pick what to (re)load. Leave a field empty to include
                        everything. This loads every translatable term —
                        Python, JavaScript, QWeb, field, view and menu — for the
                        chosen languages, whether already translated or not.
                    </p>
                    <group>
                        <field name="module_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="model_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="lang_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_load" type="object" string="Load"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_translation_loader" model="ir.actions.act_window">
        <field name="name">Refresh Translated Terms</field>
        <field name="res_model">translation.loader</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Guard: only open the wizard when more than one language is active. -->
    <record id="action_translation_loader_open" model="ir.actions.server">
        <field name="name">Refresh Terms</field>
        <field name="model_id" ref="model_translation_loader"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_loader()</field>
    </record>
</odoo>
