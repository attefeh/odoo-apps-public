<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list: the "Translated Terms" tree -->
    <record id="view_translation_term_list" model="ir.ui.view">
        <field name="name">translation.term.list</field>
        <field name="model">translation.term</field>
        <field name="arch" type="xml">
            <list string="Translated Terms" editable="bottom"
                  default_order="term_type,module,model_name,field_name">
                <field name="term_type"/>
                <field name="lang_id" options="{'no_create': True}"/>
                <field name="module" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="field_name" optional="show"/>
                <field name="res_name" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="src"/>
                <field name="value"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'translated'"
                       decoration-warning="state == 'to_translate'"/>
                <field name="is_override" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_translation_term_form" model="ir.ui.view">
        <field name="name">translation.term.form</field>
        <field name="model">translation.term</field>
        <field name="arch" type="xml">
            <form string="Translated Term">
                <sheet>
                    <group>
                        <group>
                            <field name="term_type"/>
                            <field name="lang_id" options="{'no_create': True}"/>
                            <field name="module"/>
                            <field name="is_override"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="field_name"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Source Term (en_US)">
                        <field name="src" nolabel="1"/>
                    </group>
                    <group string="Translation">
                        <field name="value" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_translation_term_search" model="ir.ui.view">
        <field name="name">translation.term.search</field>
        <field name="model">translation.term</field>
        <field name="arch" type="xml">
            <search string="Translated Terms">
                <field name="src" string="Source / Translation"
                       filter_domain="['|', ('src', 'ilike', self), ('value', 'ilike', self)]"/>
                <field name="lang_id"/>
                <field name="module"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <separator/>
                <filter name="to_translate" string="To Translate"
                        domain="[('state', '=', 'to_translate')]"/>
                <filter name="translated" string="Translated"
                        domain="[('state', '=', 'translated')]"/>
                <separator/>
                <filter name="type_field" string="Fields"
                        domain="[('term_type', 'in', ('model', 'model_term'))]"/>
                <filter name="type_code" string="Code (errors/JS)"
                        domain="[('term_type', 'in', ('code_python', 'code_web'))]"/>
                <filter name="overrides" string="Code Overrides"
                        domain="[('is_override', '=', True)]"/>
                <group>
                    <filter name="group_lang" string="Language"
                            context="{'group_by': 'lang_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'term_type'}"/>
                    <filter name="group_module" string="Module"
                            context="{'group_by': 'module'}"/>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_name'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_translation_term" model="ir.actions.act_window">
        <field name="name">Translated Terms</field>
        <field name="res_model">translation.term</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_translation_term_search"/>
        <field name="context">{'search_default_group_lang': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No translated terms loaded yet</p>
            <p>Use <b>Load / Refresh Terms</b> to populate the list with the
               translatable fields, views, menus and code strings of your
               installed modules.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_translation_manager_root"
              name="Translations"
              parent="base.menu_administration"
              sequence="50"/>
    <menuitem id="menu_translation_term"
              name="Translated Terms"
              parent="menu_translation_manager_root"
              action="action_translation_term"
              sequence="10"/>
    <menuitem id="menu_translation_loader"
              name="Load / Refresh Terms"
              parent="menu_translation_manager_root"
              action="action_translation_loader_open"
              sequence="20"/>
</odoo>
