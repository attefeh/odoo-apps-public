<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_builder_template_form" model="ir.ui.view">
        <field name="name">report.builder.template.form</field>
        <field name="model">report.builder.template</field>
        <field name="arch" type="xml">
            <form string="Report Template">
                <header>
                    <button name="action_open_editor" type="object"
                            string="Open Editor" class="btn-primary"/>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            invisible="not model_id"/>
                    <button name="action_print_preview" type="object"
                            string="Print Preview"
                            invisible="state != 'published'"/>
                    <button name="action_unpublish" type="object"
                            string="Unpublish"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Custom Invoice"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'published'"/>
                            <field name="model_name" invisible="1"/>
                            <field name="layout"/>
                            <field name="paperformat_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="add_print_binding"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Generated objects" invisible="state != 'published'">
                        <field name="report_id" readonly="1"/>
                        <field name="view_id" readonly="1"/>
                    </group>
                    <field name="body_html" invisible="1"/>
                    <field name="gjs_data" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_builder_template_list" model="ir.ui.view">
        <field name="name">report.builder.template.list</field>
        <field name="model">report.builder.template</field>
        <field name="arch" type="xml">
            <list string="Report Templates">
                <field name="name"/>
                <field name="model_id"/>
                <field name="layout"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_editor" type="object"
                        string="Edit" icon="fa-pencil-square-o"/>
            </list>
        </field>
    </record>

    <record id="view_report_builder_template_search" model="ir.ui.view">
        <field name="name">report.builder.template.search</field>
        <field name="model">report.builder.template</field>
        <field name="arch" type="xml">
            <search string="Report Templates">
                <field name="name"/>
                <field name="model_id"/>
                <filter name="published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_builder_template" model="ir.actions.act_window">
        <field name="name">Report Templates</field>
        <field name="res_model">report.builder.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your first report</p>
            <p>Click <b>New</b> to pick a model and a starter layout, then design
               your report visually.</p>
        </field>
    </record>
</odoo>
