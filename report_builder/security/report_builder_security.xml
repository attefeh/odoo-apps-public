<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_report_builder_manager" model="res.groups">
        <field name="name">Report Builder: Designer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- System administrators are Report Builder designers (version-agnostic:
         relies only on implied_ids, which exists on both 18.0 and 19.0). -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_report_builder_manager'))]"/>
    </record>

    <record id="report_builder_template_company_rule" model="ir.rule">
        <field name="name">Report Builder: per-company templates</field>
        <field name="model_id" ref="model_report_builder_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
