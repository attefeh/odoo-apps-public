<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_builder_new_form" model="ir.ui.view">
        <field name="name">report.builder.new.form</field>
        <field name="model">report.builder.new</field>
        <field name="arch" type="xml">
            <form string="New Report Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Report name"/></h1>
                    </div>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="starter"/>
                        <field name="layout"/>
                        <field name="paperformat_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_open" type="object"
                            string="Create &amp; Open Editor" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_builder_new" model="ir.actions.act_window">
        <field name="name">New Report</field>
        <field name="res_model">report.builder.new</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
